{
  "name": "fan-da-wan-life-os",
  "version": "1.0.0",
  "description": "饭大碗的游戏人生 · Life OS - Notion life operating system built with TypeScript and Node.js",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest --runInBand",
    "init": "node dist/index.js init",
    "sync": "node dist/index.js sync",
    "daily": "node dist/index.js agent daily",
    "weekly": "node dist/index.js agent weekly",
    "monthly": "node dist/index.js agent monthly",
    "dry-run": "node dist/index.js init --dry-run"
  },
  "keywords": [
    "notion",
    "life-os",
    "typescript",
    "personal-dashboard",
    "automation",
    "ai-agent"
  ],
  "author": "fisherterence16102001-pixel",
  "license": "MIT",
  "dependencies": {
    "@notionhq/client": "^1.0.1",
    "dotenv": "^16.4.5",
    "zod": "^3.26.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
